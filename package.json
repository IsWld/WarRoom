{
  "name": "warroom",
  "version": "0.0.1",
  "private": true,
  "description": "A moddable, browser-based grand strategy game set in historical world crises.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test \"engine/test/**/*.test.ts\" \"tools/test/**/*.test.ts\"",
    "validate:content": "node tools/validate-content.ts content/core",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate:content"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0"
  }
}
